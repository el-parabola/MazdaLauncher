<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/search2"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/pill_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/red_dot" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Dove vuoi andare?"
            android:textColor="@color/text_dim"
            android:textSize="17sp" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_search"
            android:tint="@color/text_dim" />

        <ImageButton
            android:id="@+id/btn_voice2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="-12dp"
            android:background="@null"
            android:contentDescription="Assistente vocale"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic"
            android:tint="#B3112E" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/place_home"
            layout="@layout/card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/place_work"
            layout="@layout/card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/dest_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.2"
        android:text="PREFERITI E RECENTI"
        android:textColor="@color/mazda_red"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dest_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Le destinazioni cercate compariranno qui.\nTieni premuta una destinazione per metterla tra i preferiti."
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/dest_0"
            layout="@layout/card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/dest_1"
            layout="@layout/card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/dest_2"
            layout="@layout/card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/dest_3"
            layout="@layout/card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
