<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/root_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- DOCK a sinistra: sole icone, in colonna -->
        <LinearLayout
            android:layout_width="84dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/line" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="d MMM"
                android:format24Hour="d MMM"
                android:letterSpacing="0.05"
                android:textAllCaps="true"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@color/line" />

        <!-- Parte alta: mappa + musica -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- MAPPA -->
            <FrameLayout
                android:id="@+id/map_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.65"
                android:background="@drawable/panel_bg">

                <org.osmdroid.views.MapView
                    android:id="@+id/map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/search"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:background="@drawable/pill_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/red_dot" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Dove vuoi andare?"
                        android:textColor="@color/text_dim"
                        android:textSize="17sp" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_search"
                        android:tint="@color/text_dim" />

                    <ImageButton
                        android:id="@+id/btn_voice"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="-12dp"
                        android:background="@null"
                        android:contentDescription="Assistente vocale"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_mic"
                        android:tint="#B3112E" />
                </LinearLayout>

                <!-- PERCORSO (prototipo online) -->
                <LinearLayout
                    android:id="@+id/route_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="72dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/pill_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/route_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/route_clear"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@null"
                        android:contentDescription="Chiudi percorso"
                        android:padding="8dp"
                        android:src="@drawable/ic_close"
                        android:tint="@color/text_dim" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/place_home"
                        style="@style/Chip">

                        <ImageView
                            style="@style/ChipIcon"
                            android:src="@drawable/ic_home" />

                        <TextView
                            android:id="@+id/place_home_text"
                            style="@style/ChipText" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/place_work"
                        style="@style/Chip"
                        android:layout_marginStart="10dp">

                        <ImageView
                            style="@style/ChipIcon"
                            android:src="@drawable/ic_work" />

                        <TextView
                            android:id="@+id/place_work_text"
                            style="@style/ChipText" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btn_center"
                        style="@style/MapButton"
                        android:src="@drawable/ic_my_location" />

                    <ImageButton
                        android:id="@+id/btn_zoom_in"
                        style="@style/MapButton"
                        android:layout_marginTop="8dp"
                        android:src="@drawable/ic_add" />

                    <ImageButton
                        android:id="@+id/btn_zoom_out"
                        style="@style/MapButton"
                        android:layout_marginTop="8dp"
                        android:src="@drawable/ic_remove" />
                </LinearLayout>
            </FrameLayout>

            <!-- MUSICA -->
            <LinearLayout
                android:id="@+id/media_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="@drawable/panel_bg"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/media_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.15"
                    android:singleLine="true"
                    android:textAllCaps="true"
                    android:textColor="@color/mazda_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/media_art"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/art_bg"
                    android:elevation="6dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/media_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/media_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/text_dim"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/media_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:max="1000"
                    android:progressBackgroundTint="#40FFFFFF"
                    android:progressTint="@color/mazda_red" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/media_elapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/media_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center|bottom"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_prev"
                        style="@style/MediaButton"
                        android:src="@drawable/ic_prev" />

                    <ImageButton
                        android:id="@+id/btn_play"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_marginStart="30dp"
                        android:layout_marginEnd="30dp"
                        android:background="@drawable/play_ring"
                        android:padding="18dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play"
                        android:tint="@color/text" />

                    <ImageButton
                        android:id="@+id/btn_next"
                        style="@style/MediaButton"
                        android:src="@drawable/ic_next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Cassetto con tutte le app -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F508090B"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:background="@color/mazda_red" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-light"
                android:text="Tutte le app"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <ImageButton
                android:id="@+id/drawer_close"
                style="@style/MediaButton"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:columnWidth="140dp"
            android:numColumns="auto_fit"
            android:stretchMode="columnWidth"
            android:verticalSpacing="16dp" />
    </LinearLayout>
</FrameLayout>
